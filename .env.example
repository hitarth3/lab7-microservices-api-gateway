# ==============================================================================
# Lab 7: API Gateway, Service Discovery & Cloud Deployment Configuration (.env.example)
# ==============================================================================

# Public Entry Point (Only Gateway Port Exposed to Host/Internet)
GATEWAY_PORT=8080

# Service Discovery Registry (Dynamic URL mappings for the Gateway)
# In Docker Compose: internal container DNS names
# In Local dev: http://localhost:3001, etc.
# In Cloud: internal service networking or cloud provider internal hostnames
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003

# Internal Service Inter-communication Timeout (ms)
CALL_TIMEOUT_MS=3000

# Cloud Deployment MongoDB Atlas URI (Optional override for cloud persistence)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/
